# PayPal sandbox credentials. Keep the real values in .env.local only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_BUSINESS_NAME=FieldNote Services

# Vercel AI Gateway. Vercel deployments use OIDC automatically.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4-mini
AI_GATEWAY_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
